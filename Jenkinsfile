pipeline {

    agent any

    stages {

        stage('Checkout') {

            steps {
            //download the source code from the Git repository
                git branch: 'main',
                    url: 'https://github.com/Malleshgoud/Selenium-POM-Jenkins-Integration.git'
            }
        }

        stage('Build') {
//run the Maven build command to compile the code and run the tests
            steps {

                bat 'mvn clean test'
            }
        }
    }

    post {

        always {
        //archive the test reports generated by the Maven build

            archiveArtifacts artifacts: 'reports/**'

            echo 'Reports archived'
        }
    }
}